  "concepts": [
    {
      "name": "反正弦函数",
      "type": "definition",
      "formal": "如果 $z = \\sin w$, 则 $w$ 称为 $z$ 的反正弦函数, 记作 $w = \\operatorname{Arcsin} z$",
      "source_quote": "如果 $z = \\sin w$, 则 $w$ 称为 $z$ 的反正弦函数, 记作 $w = \\operatorname{Arcsin} z$"
    },
    {
      "name": "反余弦函数",
      "type": "definition",
      "formal": "如果 $z = \\cos w$, 则 $w$ 称为 $z$ 的反余弦函数, 记作 $w = \\operatorname{Arccos} z$",
      "source_quote": "如果 $z = \\cos w$, 则 $w$ 称为 $z$ 的反余弦函数, 记作 $w = \\operatorname{Arccos} z$"
    },
    {
      "name": "反正弦函数表达式",
      "type": "formula",
      "formal": "$w = \\operatorname{Arcsin} z = - \\mathrm{iLn} (\\mathrm{i} z + \\sqrt {1 - z ^ {2}}).$",
      "source_quote": "$w = \\operatorname{Arcsin} z = - \\mathrm{iLn} (\\mathrm{i} z + \\sqrt {1 - z ^ {2}}).$"
    },
    {
      "name": "反余弦函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arccosz} = - \\mathrm{iLn} (z + \\sqrt {z ^ {2} - 1}),$",
      "source_quote": "$\\mathrm{Arccosz} = - \\mathrm{iLn} (z + \\sqrt {z ^ {2} - 1}),$"
    },
    {
      "name": "反正切函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arctanz} = - \\frac {\\mathrm{i}}{2} \\mathrm{Ln} \\frac {1 + \\mathrm{i} z}{1 - \\mathrm{i} z},$",
      "source_quote": "$\\mathrm{Arctanz} = - \\frac {\\mathrm{i}}{2} \\mathrm{Ln} \\frac {1 + \\mathrm{i} z}{1 - \\mathrm{i} z},$"
    },
    {
      "name": "反余切函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arccotz} = \\frac {\\mathrm{i}}{2} \\mathrm{Ln} \\frac {z - \\mathrm{i}}{z + \\mathrm{i}},$",
      "source_quote": "$\\mathrm{Arccotz} = \\frac {\\mathrm{i}}{2} \\mathrm{Ln} \\frac {z - \\mathrm{i}}{z + \\mathrm{i}},$"
    },
    {
      "name": "反双曲正弦函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arsinhz} = \\mathrm{Ln} (z + \\sqrt {z ^ {2} + 1}),$",
      "source_quote": "$\\mathrm{Arsinhz} = \\mathrm{Ln} (z + \\sqrt {z ^ {2} + 1}),$"
    },
    {
      "name": "反双曲余弦函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arcoshz} = \\mathrm{Ln} (z + \\sqrt {z ^ {2} - 1}),$",
      "source_quote": "$\\mathrm{Arcoshz} = \\mathrm{Ln} (z + \\sqrt {z ^ {2} - 1}),$"
    },
    {
      "name": "反双曲正切函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Artanhz} = \\frac {1}{2} \\mathrm{Ln} \\frac {1 + z}{1 - z},$",
      "source_quote": "$\\mathrm{Artanhz} = \\frac {1}{2} \\mathrm{Ln} \\frac {1 + z}{1 - z},$"
    },
    {
      "name": "反双曲余切函数表达式",
      "type": "formula",
      "formal": "$\\mathrm{Arcothz} = \\frac {1}{2} \\mathrm{Ln} \\frac {z + 1}{z - 1}.$",
      "source_quote": "$\\mathrm{Arcothz} = \\frac {1}{2} \\mathrm{Ln} \\frac {z + 1}{z - 1}.$"
