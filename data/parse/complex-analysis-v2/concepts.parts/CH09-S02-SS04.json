    {
      "name": "本函数的积分法（积分性质）",
      "type": "property",
      "formal": "设 $\\mathrm{L}[f(t)] = F(p)$，则 $$\\mathrm{L} \\left[ \\int_ {0} ^ {t} f (t) \\mathrm{d} t \\right] = \\frac {F (p)}{p}.$$",
      "source_quote": "设 $\\mathrm{L}[f(t)] = F(p)$，则 $$\\mathrm{L} \\left[ \\int_ {0} ^ {t} f (t) \\mathrm{d} t \\right] = \\frac {F (p)}{p}.$$"
    },
    {
      "name": "本函数的微分法",
      "type": "property",
      "formal": "$$\\mathrm{L} \\left[ \\varphi^ {\\prime} (t) \\right] = p \\mathrm{L} [ \\varphi (t) ] - \\varphi (0)$$",
      "source_quote": "由本函数的微分法，有 $$\\mathrm{L} \\left[ \\varphi^ {\\prime} (t) \\right] = p \\mathrm{L} [ \\varphi (t) ] - \\varphi (0) = p \\mathrm{L} [ \\varphi (t) ].$$"
    },
    {
      "name": "回路电压定律",
      "type": "law",
      "formal": "由回路电压定律, 得电路方程 $$R i (t) + \\frac {1}{C} \\int_ {0} ^ {t} i (t) d t = E.$$",
      "source_quote": "由回路电压定律, 得电路方程"
    }
